@using Checkers.App.ViewModels
@implements IDisposable

<aside class="panel analysis-panel" aria-label="Analysis">
    <h2>ANALYSIS</h2>
    <dl class="analysis-grid">
        <dt>Move:</dt>
        <dd>@Analysis.Move</dd>

        <dt>Depth:</dt>
        <dd>@Analysis.Depth</dd>

        <dt>Value:</dt>
        <dd>@Analysis.Value</dd>

        <dt>Best move:</dt>
        <dd>@Analysis.BestMove</dd>

        <dt>Nodes:</dt>
        <dd>@Analysis.Nodes</dd>

        <dt>Evaluations:</dt>
        <dd>@Analysis.Evaluations</dd>

        <dt>Time:</dt>
        <dd>@Analysis.Time</dd>
    </dl>
</aside>

@code {
    [Parameter, EditorRequired]
    public AnalysisViewModel Analysis { get; set; } = default!;

    private bool _renderPending;

    protected override void OnInitialized()
    {
        Analysis.Updated += OnAnalysisUpdated;
    }

    private void OnAnalysisUpdated()
    {
        if (_renderPending)
            return;

        _renderPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _renderPending = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Analysis.Updated -= OnAnalysisUpdated;
    }
}

