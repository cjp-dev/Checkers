@using Checkers.App.ViewModels
@using Checkers.Core.Models
@inject IJSRuntime JS

<div class="checkerboard-container">
    <div class="checkerboard"
         role="grid"
         aria-label="Checkers Board"
         @onpointerup="HandlePointerUp"
         @onpointercancel="() => _draggedSquare = null">
        @for (int sr = 0; sr < 8; sr++)
        {
            @for (int sc = 0; sc < 8; sc++)
            {
                int r = IsFlipped ? 7 - sr : sr;
                int c = IsFlipped ? 7 - sc : sc;
                var sq = Squares[r, c];
                bool isDark = sq.IsDarkSquare;
                string squareClass = GetSquareClasses(sq);

                <div class="square @squareClass"
                     role="gridcell"
                     tabindex="0"
                     data-row="@r"
                     data-col="@c"
                     aria-label="@GetSquareAriaLabel(sq)"
                     @onclick="() => OnSquareClick.InvokeAsync(sq)"
                     @onkeydown="e => HandleKeyDown(e, sq)"
                     @ondragover:preventDefault
                     @ondrop="() => HandleDrop(sq)">

                    @if (isDark && sq.DraughtsNumber.HasValue)
                    {
                        <span class="square-number">@sq.DraughtsNumber.Value</span>
                    }

                    @if (sq.HasPiece)
                    {
                        var piece = sq.Piece!.Value;
                        string pieceClass = piece.Color == PieceColor.White ? "piece piece-white" : "piece piece-black";
                        if (piece.IsKing) pieceClass += " piece-king";
                        if (sq.IsSelected) pieceClass += " piece-selected";
                        if (sq.IsMovable) pieceClass += " piece-movable";

                        <div class="@pieceClass"
                             draggable="@(sq.IsMovable ? "true" : "false")"
                             @ondragstart="() => _draggedSquare = sq"
                             @onpointerdown="() => HandlePointerDown(sq)">
                            @if (piece.IsKing)
                            {
                                <span class="crown">👑</span>
                            }
                        </div>
                    }

                    @if (sq.IsValidTarget)
                    {
                        <div class="target-indicator"></div>
                    }
                    @if (sq.IsCapturedTarget)
                    {
                        <div class="capture-target-indicator"></div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private SquareViewModel? _draggedSquare;

    [Parameter, EditorRequired]
    public SquareViewModel[,] Squares { get; set; } = new SquareViewModel[8, 8];

    [Parameter]
    public bool IsFlipped { get; set; }

    [Parameter]
    public EventCallback<SquareViewModel> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback<(SquareViewModel From, SquareViewModel To)> OnSquareDragDrop { get; set; }

    private async Task HandleDrop(SquareViewModel target)
    {
        if (_draggedSquare != null && _draggedSquare != target)
        {
            await OnSquareDragDrop.InvokeAsync((_draggedSquare, target));
            _draggedSquare = null;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e, SquareViewModel sq)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnSquareClick.InvokeAsync(sq);
        }
    }

    private void HandlePointerDown(SquareViewModel sq)
    {
        if (sq.IsMovable)
        {
            _draggedSquare = sq;
        }
    }

    private async Task HandlePointerUp(PointerEventArgs e)
    {
        if (_draggedSquare != null)
        {
            try
            {
                var coords = await JS.InvokeAsync<int[]?>("checkers.getSquareAtPoint", e.ClientX, e.ClientY);
                if (coords != null && coords.Length == 2)
                {
                    int tr = coords[0];
                    int tc = coords[1];
                    if (tr >= 0 && tr < 8 && tc >= 0 && tc < 8)
                    {
                        var target = Squares[tr, tc];
                        if (target != _draggedSquare)
                        {
                            await OnSquareDragDrop.InvokeAsync((_draggedSquare, target));
                        }
                    }
                }
            }
            catch
            {
                // Ignore JS interop failure on pointerup
            }
            finally
            {
                _draggedSquare = null;
            }
        }
    }

    private static string GetSquareClasses(SquareViewModel sq)
    {
        var classes = new List<string> { sq.IsDarkSquare ? "dark" : "light" };

        if (sq.IsSelected) classes.Add("selected");
        if (sq.IsValidTarget) classes.Add("valid-target");
        if (sq.IsCapturedTarget) classes.Add("captured-target");
        if (sq.IsLastMoveFrom) classes.Add("last-from");
        if (sq.IsLastMoveTo) classes.Add("last-to");
        if (sq.IsMandatoryCaptureSource) classes.Add("mandatory-capture");
        if (sq.IsMovable) classes.Add("movable");

        return string.Join(" ", classes);
    }

    private static string GetSquareAriaLabel(SquareViewModel sq)
    {
        string pos = sq.DraughtsNumber.HasValue ? $"Square {sq.DraughtsNumber.Value}" : $"Row {sq.Row + 1}, Column {sq.Col + 1}";
        if (!sq.HasPiece) return pos;
        var p = sq.Piece!.Value;
        return $"{pos}, {p.Color} {(p.IsKing ? "King" : "Man")}";
    }
}
