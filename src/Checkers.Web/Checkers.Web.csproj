<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The engine is CPU-bound, so CI publish compiles it to WebAssembly AOT (needs: dotnet workload install wasm-tools). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and ('$(RunAOTCompilation)' == 'true' or '$(GITHUB_ACTIONS)' == 'true')">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Checkers.App\Checkers.App.csproj" />
    <ProjectReference Include="..\Checkers.Core\Checkers.Core.csproj" />
    <!-- The shared game GUI (git submodule). -->
    <ProjectReference Include="..\..\external\GameShell\src\GameShell\GameShell.csproj" />
  </ItemGroup>

  <!-- The brain documentation is shown by the Docs pages; copied into wwwroot (git-ignored). -->
  <Target Name="CopyBrainDocs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <BrainDocs Include="..\..\docs\brain\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrainDocs)" DestinationFiles="@(BrainDocs->'wwwroot\content\brain\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\content\brain\**" />
      <Content Include="wwwroot\content\brain\**" />
    </ItemGroup>
  </Target>

  <!-- The picture in the About box, shared with the desktop version (git-ignored copy). -->
  <Target Name="CopyAboutPicture" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="..\..\Images\2026 Claus Pedersen.jpg" DestinationFiles="wwwroot\images\claus-pedersen.jpg" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\images\claus-pedersen.jpg" />
      <Content Include="wwwroot\images\claus-pedersen.jpg" />
    </ItemGroup>
  </Target>

  <!--
    The multithreaded engine (Checkers.Web.Engine) for local builds: published into wwwroot/engine/_framework
    (git-ignored) whenever its sources change. CI publishes it in the deploy workflow instead.
    Pass -p:RunAOTCompilation=true for an AOT-compiled engine (needs the wasm-tools workload).
  -->
  <Target Name="BuildEngine" BeforeTargets="AssignTargetPaths" Condition="'$(GITHUB_ACTIONS)' != 'true'"
          Inputs="@(EngineSources)" Outputs="$(EngineStamp)">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Checkers.Web.Engine/Checkers.Web.Engine.csproj&quot; -c Release -p:RunAOTCompilation=$(RunAOTCompilation) -p:IntermediateOutputPath=&quot;$(EngineWorkDir)obj/&quot; -p:OutputPath=&quot;$(EngineWorkDir)bin/&quot; -o &quot;$(EnginePublishDir)&quot;" />
    <RemoveDir Directories="wwwroot\engine" />
    <ItemGroup>
      <!-- Not the engine's own .br/.gz files: this app's static web assets compress the copies themselves,
           and two sets of compressed files for one asset make the dev server send a body that doesn't match. -->
      <EngineAssets Include="$(EnginePublishDir)wwwroot\_framework\**\*" Exclude="$(EnginePublishDir)wwwroot\_framework\**\*.br;$(EnginePublishDir)wwwroot\_framework\**\*.gz" />
    </ItemGroup>
    <Copy SourceFiles="@(EngineAssets)" DestinationFiles="@(EngineAssets->'wwwroot\engine\_framework\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Touch Files="$(EngineStamp)" AlwaysCreate="true" />
    <!-- The wwwroot items were collected before this target replaced the files. -->
    <ItemGroup>
      <Content Remove="wwwroot\engine\**" />
      <Content Include="wwwroot\engine\**" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <EnginePublishDir>$(MSBuildProjectDirectory)/obj/engine_pub/</EnginePublishDir>
    <!-- Own obj/bin folders, so this publish can't collide with a solution build of the engine project. -->
    <EngineWorkDir>$(MSBuildProjectDirectory)/obj/engine_work/</EngineWorkDir>
    <EngineStamp>$(MSBuildProjectDirectory)/obj/engine_pub.stamp</EngineStamp>
  </PropertyGroup>

  <ItemGroup>
    <EngineSources Include="..\Checkers.Web.Engine\**\*.cs;..\Checkers.Web.Engine\*.csproj;..\Checkers.Core\**\*.cs;..\Checkers.Core\**\*.csproj;..\Checkers.Core\**\*.txt;..\Checkers.App\**\*.cs;Worker\EngineProtocol.cs"
                   Exclude="..\**\bin\**;..\**\obj\**" />
  </ItemGroup>

</Project>
