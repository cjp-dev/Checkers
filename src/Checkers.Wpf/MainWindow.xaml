<Window x:Class="Checkers.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Checkers.App.Models;assembly=Checkers.App"
        xmlns:views="clr-namespace:Checkers.Wpf.Views"
        xmlns:vm="clr-namespace:Checkers.App.ViewModels;assembly=Checkers.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Width="960" Height="730"
        MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewGameCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Main Top Menu with Checkmarks -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New Game" InputGestureText="Ctrl+N" Command="{Binding NewGameCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Header="_Game">
                <MenuItem Header="Human vs _Computer"
                          IsCheckable="True"
                          IsChecked="{Binding IsHumanVsComputer, Mode=OneWay}"
                          Command="{Binding SetGameModeCommand}"
                          CommandParameter="{x:Static models:GameMode.HumanVsComputer}" />
                <MenuItem Header="Human vs _Human"
                          IsCheckable="True"
                          IsChecked="{Binding IsHumanVsHuman, Mode=OneWay}"
                          Command="{Binding SetGameModeCommand}"
                          CommandParameter="{x:Static models:GameMode.HumanVsHuman}" />
                <Separator />
                <MenuItem Header="Difficulty" IsEnabled="{Binding IsAiDifficultyEnabled}">
                    <MenuItem Header="_Easy (Random)"
                              IsCheckable="True"
                              IsChecked="{Binding IsEasyDifficulty, Mode=OneWay}"
                              Command="{Binding SetDifficultyCommand}"
                              CommandParameter="{x:Static models:AiDifficulty.Easy}" />
                    <MenuItem Header="_Medium (Minimax 3)"
                              IsCheckable="True"
                              IsChecked="{Binding IsMediumDifficulty, Mode=OneWay}"
                              Command="{Binding SetDifficultyCommand}"
                              CommandParameter="{x:Static models:AiDifficulty.Medium}" />
                    <MenuItem Header="_Hard (Minimax 6)"
                              IsCheckable="True"
                              IsChecked="{Binding IsHardDifficulty, Mode=OneWay}"
                              Command="{Binding SetDifficultyCommand}"
                              CommandParameter="{x:Static models:AiDifficulty.Hard}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Moves">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Sound" IsCheckable="True" IsChecked="{Binding IsSoundOn}" Command="{Binding ToggleSoundCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Checkers..." Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Main Body -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Board Area with Header Indicators (Scales automatically) -->
            <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Board Mode & Difficulty Banner -->
                <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,6" Background="#FFFFFF" CornerRadius="6" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.08" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MODE: " FontSize="11" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Border Background="#2C3E50" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="{Binding GameModeBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>

                        <TextBlock Text="DIFFICULTY: " FontSize="11" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding IsAiDifficultyEnabled, Converter={StaticResource BoolToVis}}" />
                        <Border CornerRadius="4" Padding="8,3"
                                Visibility="{Binding IsAiDifficultyEnabled, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2980B9" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEasyDifficulty}" Value="True">
                                            <Setter Property="Background" Value="#27AE60" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMediumDifficulty}" Value="True">
                                            <Setter Property="Background" Value="#2980B9" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHardDifficulty}" Value="True">
                                            <Setter Property="Background" Value="#C0392B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding DifficultyBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 8x8 Board -->
                <views:BoardView Grid.Row="1" />
            </Grid>

            <!-- Right Sidebar Controls & Information -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status Panel -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.1" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="GAME STATUS" FontSize="11" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding GameModeDescription}" FontSize="10" FontWeight="SemiBold" Foreground="#3498DB" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2C3E50" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding MoveCountText}" FontSize="12" Foreground="#7F8C8D" />
                        <!-- AI Thinking Indicator -->
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0"
                                     Foreground="#3498DB"
                                     Visibility="{Binding IsAiThinking, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Mode & Difficulty Settings Panel -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.1" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="GAME MODE" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding SetGameModeCommand}"
                                    CommandParameter="{x:Static models:GameMode.HumanVsComputer}"
                                    Margin="0,0,3,0" Padding="6,6" FontSize="11" FontWeight="SemiBold"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Setter Property="Foreground" Value="#546E7A" />
                                        <Setter Property="Content" Value="vs Computer" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHumanVsComputer}" Value="True">
                                                <Setter Property="Background" Value="#2C3E50" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="Content" Value="✓ vs Computer" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{Binding SetGameModeCommand}"
                                    CommandParameter="{x:Static models:GameMode.HumanVsHuman}"
                                    Margin="3,0,0,0" Padding="6,6" FontSize="11" FontWeight="SemiBold"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Setter Property="Foreground" Value="#546E7A" />
                                        <Setter Property="Content" Value="vs Human" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHumanVsHuman}" Value="True">
                                                <Setter Property="Background" Value="#2C3E50" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="Content" Value="✓ vs Human" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="AI DIFFICULTY" FontSize="11" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Left" />
                            <TextBlock Text="(vs Human mode)" FontSize="10" Foreground="#B0BEC5" HorizontalAlignment="Right"
                                       Visibility="{Binding IsHumanVsHuman, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <Grid IsEnabled="{Binding IsAiDifficultyEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding SetDifficultyCommand}"
                                    CommandParameter="{x:Static models:AiDifficulty.Easy}"
                                    Margin="0,0,2,0" Padding="4,6" FontSize="11" FontWeight="SemiBold"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Setter Property="Foreground" Value="#546E7A" />
                                        <Setter Property="Content" Value="Easy" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEasyDifficulty}" Value="True">
                                                <Setter Property="Background" Value="#27AE60" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="Content" Value="✓ Easy" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{Binding SetDifficultyCommand}"
                                    CommandParameter="{x:Static models:AiDifficulty.Medium}"
                                    Margin="2,0,2,0" Padding="4,6" FontSize="11" FontWeight="SemiBold"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Setter Property="Foreground" Value="#546E7A" />
                                        <Setter Property="Content" Value="Medium" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediumDifficulty}" Value="True">
                                                <Setter Property="Background" Value="#2980B9" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="Content" Value="✓ Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding SetDifficultyCommand}"
                                    CommandParameter="{x:Static models:AiDifficulty.Hard}"
                                    Margin="2,0,0,0" Padding="4,6" FontSize="11" FontWeight="SemiBold"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Setter Property="Foreground" Value="#546E7A" />
                                        <Setter Property="Content" Value="Hard" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHardDifficulty}" Value="True">
                                                <Setter Property="Background" Value="#C0392B" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="Content" Value="✓ Hard" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Pieces & Score Panel -->
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.1" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- White Pieces -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="#DDD5C7" Stroke="#B5A995" StrokeThickness="1.5" Margin="0,0,6,0" />
                                <TextBlock Text="White" FontWeight="Bold" FontSize="13" Foreground="#333333" />
                            </StackPanel>
                            <TextBlock Text="{Binding WhitePlayerLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50" Text="{Binding WhitePiecesCount}" />
                            <TextBlock FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center">
                                <Run Text="Kings: " /><Run Text="{Binding WhiteKingsCount}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Black Pieces -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="#2B2B2B" Stroke="#181818" StrokeThickness="1.5" Margin="0,0,6,0" />
                                <TextBlock Text="Black" FontWeight="Bold" FontSize="13" Foreground="#333333" />
                            </StackPanel>
                            <TextBlock Text="{Binding BlackPlayerLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#E67E22" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50" Text="{Binding BlackPiecesCount}" />
                            <TextBlock FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center">
                                <Run Text="Kings: " /><Run Text="{Binding BlackKingsCount}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick Action Buttons -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="New" Command="{Binding NewGameCommand}" Margin="0,0,4,0" Padding="8,6" Background="#3498DB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                    <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="2,0,2,0" Padding="8,6" Background="#ECEFF1" Foreground="#333333" BorderThickness="0" Cursor="Hand" />
                    <Button Grid.Column="2" Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Margin="4,0,0,0" Padding="8,6" Background="#ECEFF1" Foreground="#333333" BorderThickness="0" Cursor="Hand" />
                </Grid>

                <!-- Move History -->
                <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="6" Padding="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.1" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="MOVE HISTORY" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8" />

                        <ListBox Grid.Row="1" ItemsSource="{Binding MoveHistoryList}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Notation}" FontSize="13" FontWeight="Medium" Foreground="#2C3E50" Padding="4,2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
