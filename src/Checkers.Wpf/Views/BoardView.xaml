<UserControl x:Class="Checkers.Wpf.Views.BoardView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Checkers.App.ViewModels;assembly=Checkers.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="560" d:DesignHeight="560">

    <UserControl.Resources>
        <!-- Board Square Colors -->
        <SolidColorBrush x:Key="LightSquareBrush" Color="#ECE5D8" />
        <SolidColorBrush x:Key="DarkSquareBrush" Color="#3C5A3E" />
        
        <!-- Piece Brushes -->
        <RadialGradientBrush x:Key="WhitePieceBrush" Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Color="#FFFFFF" Offset="0.0" />
            <GradientStop Color="#F3EFE6" Offset="0.6" />
            <GradientStop Color="#DDD5C7" Offset="1.0" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="WhitePieceBorderBrush" Color="#B5A995" />

        <RadialGradientBrush x:Key="BlackPieceBrush" Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Color="#4A4A4A" Offset="0.0" />
            <GradientStop Color="#2B2B2B" Offset="0.6" />
            <GradientStop Color="#181818" Offset="1.0" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="BlackPieceBorderBrush" Color="#0D0D0D" />

        <!-- Highlights -->
        <SolidColorBrush x:Key="SelectedBrush" Color="#FFD700" />
        <SolidColorBrush x:Key="TargetDotBrush" Color="#2ECC71" />
        <SolidColorBrush x:Key="MandatoryBrush" Color="#E74C3C" />
        <SolidColorBrush x:Key="LastMoveBrush" Color="#F39C12" />
        <SolidColorBrush x:Key="MovableRingBrush" Color="#2ECC71" />

        <!-- Boolean To Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Border BorderBrush="#253826" BorderThickness="10" CornerRadius="4" Background="#253826">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="315" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>

            <Grid Width="560" Height="560"
                  PreviewMouseLeftButtonUp="OnBoardPreviewMouseLeftButtonUp">
                <ItemsControl ItemsSource="{Binding BoardSquares}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="8" Columns="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SquareViewModel}">
                            <Button Click="OnSquareButtonClick"
                                    PreviewMouseLeftButtonDown="OnSquarePreviewMouseLeftButtonDown"
                                    PreviewMouseMove="OnSquarePreviewMouseMove"
                                    MouseEnter="OnSquareMouseEnter"
                                    MouseLeave="OnSquareMouseLeave"
                                    Focusable="False">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Arrow" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanInteract}" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="SquareRoot" Width="70" Height="70">
                                            <!-- Square Background -->
                                            <Rectangle x:Name="SquareBg" Fill="{StaticResource LightSquareBrush}" />

                                            <!-- Last Move Highlight -->
                                            <Rectangle x:Name="LastMoveMarker"
                                                       Fill="{StaticResource LastMoveBrush}"
                                                       Opacity="0.3"
                                                       Visibility="{Binding IsLastMove, Converter={StaticResource BoolToVis}}" />

                                            <!-- Mandatory Capture Indicator -->
                                            <Border x:Name="MandatoryMarker"
                                                    BorderBrush="{StaticResource MandatoryBrush}"
                                                    BorderThickness="3"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsMandatoryCaptureSource, Converter={StaticResource BoolToVis}}" />

                                            <!-- Selected Highlight -->
                                            <Border x:Name="SelectedMarker"
                                                    BorderBrush="{StaticResource SelectedBrush}"
                                                    BorderThickness="3.5"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                            <!-- Enemy Piece Captured Target Crosshair Indicator -->
                                            <Grid Visibility="{Binding IsCapturedTarget, Converter={StaticResource BoolToVis}}"
                                                  IsHitTestVisible="False">
                                                <!-- Red Pulsing Target Ring -->
                                                <Ellipse Width="46" Height="46"
                                                         Stroke="#E74C3C"
                                                         StrokeThickness="2.5"
                                                         StrokeDashArray="3,2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#E74C3C" Opacity="0.9" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <!-- Red Crosshair lines -->
                                                <Line X1="35" Y1="6" X2="35" Y2="14" Stroke="#E74C3C" StrokeThickness="2" />
                                                <Line X1="35" Y1="56" X2="35" Y2="64" Stroke="#E74C3C" StrokeThickness="2" />
                                                <Line X1="6" Y1="35" X2="14" Y2="35" Stroke="#E74C3C" StrokeThickness="2" />
                                                <Line X1="56" Y1="35" X2="64" Y2="35" Stroke="#E74C3C" StrokeThickness="2" />
                                            </Grid>

                                            <!-- Draughts Square Number (1..32) -->
                                            <TextBlock Text="{Binding DraughtsNumber}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#50FFFFFF"
                                                       Margin="4,2,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding IsDark, Converter={StaticResource BoolToVis}}" />

                                            <!-- Valid Target Marker (when selected piece can land here) -->
                                            <Grid Visibility="{Binding IsValidTarget, Converter={StaticResource BoolToVis}}"
                                                  IsHitTestVisible="False">
                                                <!-- Outer ring -->
                                                <Ellipse Width="34" Height="34"
                                                         Stroke="{StaticResource TargetDotBrush}"
                                                         StrokeThickness="2"
                                                         Opacity="0.7">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#2ECC71" Opacity="0.8" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <!-- Center target dot -->
                                                <Ellipse Width="18" Height="18"
                                                         Fill="{StaticResource TargetDotBrush}"
                                                         Opacity="0.95" />
                                            </Grid>

                                            <!-- Piece Visual -->
                                            <Grid Visibility="{Binding HasPiece, Converter={StaticResource BoolToVis}}"
                                                  Margin="6"
                                                  IsHitTestVisible="False">
                                                <!-- Piece Shadow -->
                                                <Ellipse Margin="2,4,0,0" Fill="#40000000">
                                                    <Ellipse.Effect>
                                                        <BlurEffect Radius="4" />
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <!-- Movable Glow Ring -->
                                                <Ellipse Margin="-2"
                                                         Stroke="{StaticResource MovableRingBrush}"
                                                         StrokeThickness="2.5"
                                                         StrokeDashArray="3,2"
                                                         Visibility="{Binding IsMovable, Converter={StaticResource BoolToVis}}"
                                                         IsHitTestVisible="False">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#2ECC71" Opacity="0.9" />
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <!-- Outer Disc -->
                                                <Ellipse x:Name="PieceDisc"
                                                         Fill="{StaticResource WhitePieceBrush}"
                                                         Stroke="{StaticResource WhitePieceBorderBrush}"
                                                         StrokeThickness="2" />

                                                <!-- Inner Grooves (Traditional Checkers Rings) -->
                                                <Ellipse Margin="6"
                                                         Stroke="#25000000"
                                                         StrokeThickness="1.5" />
                                                <Ellipse Margin="12"
                                                         Stroke="#20000000"
                                                         StrokeThickness="1" />

                                                <!-- King Crown Glyph -->
                                                <Viewbox Width="26" Height="26"
                                                         Visibility="{Binding IsKing, Converter={StaticResource BoolToVis}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 3,18 L 3,19 C 3,19.5 3.5,20 4,20 L 20,20 C 20.5,20 21,19.5 21,19 L 21,18 Z M 4,16 L 3,7 L 7.5,12 L 12,4 L 16.5,12 L 21,7 L 20,16 Z"
                                                              Fill="#F1C40F"
                                                              Stroke="#B7950B"
                                                              StrokeThickness="1">
                                                            <Path.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.5" />
                                                            </Path.Effect>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <!-- Dark Square Trigger -->
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter TargetName="SquareBg" Property="Fill" Value="{StaticResource DarkSquareBrush}" />
                                            </DataTrigger>

                                            <!-- Black Piece Trigger -->
                                            <DataTrigger Binding="{Binding IsBlackPiece}" Value="True">
                                                <Setter TargetName="PieceDisc" Property="Fill" Value="{StaticResource BlackPieceBrush}" />
                                                <Setter TargetName="PieceDisc" Property="Stroke" Value="{StaticResource BlackPieceBorderBrush}" />
                                            </DataTrigger>

                                            <!-- Hover effect for interactive squares -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                    <Condition Binding="{Binding CanInteract}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="SquareBg" Property="Opacity" Value="0.82" />
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
